{
  "$defs": {
    "Leg": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "minutes": {
          "minimum": 0,
          "title": "Minutes",
          "type": "integer"
        },
        "mode": {
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "minutes"
      ],
      "title": "Leg",
      "type": "object"
    },
    "SourceLabel": {
      "additionalProperties": false,
      "description": "Where a value came from, and how fresh it is.",
      "properties": {
        "captured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At"
        },
        "data_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Date"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "status": {
          "enum": [
            "live",
            "cached",
            "fallback",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "source"
      ],
      "title": "SourceLabel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dates_set": {
      "title": "Dates Set",
      "type": "boolean"
    },
    "destination": {
      "title": "Destination",
      "type": "string"
    },
    "kind": {
      "const": "transport_route",
      "title": "Kind",
      "type": "string"
    },
    "leaves_at": {
      "anyOf": [
        {
          "format": "time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Leaves At"
    },
    "legs": {
      "items": {
        "$ref": "#/$defs/Leg"
      },
      "title": "Legs",
      "type": "array"
    },
    "missing": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Missing"
    },
    "origin": {
      "title": "Origin",
      "type": "string"
    },
    "planned_for": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Planned For"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceLabel"
      },
      "title": "Sources",
      "type": "array"
    },
    "state": {
      "enum": [
        "loading",
        "filled",
        "empty",
        "error",
        "not_known"
      ],
      "title": "State",
      "type": "string"
    },
    "total_minutes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Minutes"
    }
  },
  "required": [
    "state",
    "sources",
    "kind",
    "origin",
    "destination",
    "dates_set"
  ],
  "title": "TransportRoute",
  "type": "object"
}
