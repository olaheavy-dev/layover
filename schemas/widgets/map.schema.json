{
  "$defs": {
    "MapPlace": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "name",
        "lat",
        "lon"
      ],
      "title": "MapPlace",
      "type": "object"
    },
    "SourceLabel": {
      "additionalProperties": false,
      "description": "Where a value came from, and how fresh it is.",
      "properties": {
        "captured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At"
        },
        "data_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Date"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "status": {
          "enum": [
            "live",
            "cached",
            "fallback",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "source"
      ],
      "title": "SourceLabel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "centre": {
      "anyOf": [
        {
          "$ref": "#/$defs/MapPlace"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "hotel": {
      "anyOf": [
        {
          "$ref": "#/$defs/MapPlace"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kind": {
      "const": "map",
      "title": "Kind",
      "type": "string"
    },
    "missing": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Missing"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceLabel"
      },
      "title": "Sources",
      "type": "array"
    },
    "state": {
      "enum": [
        "loading",
        "filled",
        "empty",
        "error",
        "not_known"
      ],
      "title": "State",
      "type": "string"
    },
    "stops": {
      "items": {
        "$ref": "#/$defs/MapPlace"
      },
      "title": "Stops",
      "type": "array"
    }
  },
  "required": [
    "state",
    "sources",
    "kind"
  ],
  "title": "Map",
  "type": "object"
}
