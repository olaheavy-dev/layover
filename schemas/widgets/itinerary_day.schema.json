{
  "$defs": {
    "SourceLabel": {
      "additionalProperties": false,
      "description": "Where a value came from, and how fresh it is.",
      "properties": {
        "captured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At"
        },
        "data_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Date"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "status": {
          "enum": [
            "live",
            "cached",
            "fallback",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "source"
      ],
      "title": "SourceLabel",
      "type": "object"
    },
    "Stop": {
      "additionalProperties": false,
      "properties": {
        "closes": {
          "anyOf": [
            {
              "format": "time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closes"
        },
        "hours_status": {
          "default": "not_applicable",
          "enum": [
            "known",
            "not_known",
            "not_applicable"
          ],
          "title": "Hours Status",
          "type": "string"
        },
        "kind": {
          "default": "place",
          "enum": [
            "place",
            "walk"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "opens": {
          "anyOf": [
            {
              "format": "time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opens"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLabel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ],
      "title": "Stop",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base"
    },
    "day": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Day"
    },
    "day_number": {
      "minimum": 1,
      "title": "Day Number",
      "type": "integer"
    },
    "kind": {
      "const": "itinerary_day",
      "title": "Kind",
      "type": "string"
    },
    "missing": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Missing"
    },
    "rebuilt": {
      "default": false,
      "title": "Rebuilt",
      "type": "boolean"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceLabel"
      },
      "title": "Sources",
      "type": "array"
    },
    "starts_from_centre": {
      "default": false,
      "title": "Starts From Centre",
      "type": "boolean"
    },
    "state": {
      "enum": [
        "loading",
        "filled",
        "empty",
        "error",
        "not_known"
      ],
      "title": "State",
      "type": "string"
    },
    "stops": {
      "items": {
        "$ref": "#/$defs/Stop"
      },
      "title": "Stops",
      "type": "array"
    }
  },
  "required": [
    "state",
    "sources",
    "kind",
    "day_number"
  ],
  "title": "ItineraryDay",
  "type": "object"
}
