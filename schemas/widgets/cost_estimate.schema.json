{
  "$defs": {
    "CostLine": {
      "additionalProperties": false,
      "description": "One line of a cost estimate. A line with no amount says why (decision 0011, rule 4).",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoneyEstimate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "listing_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Listing Count"
        },
        "missing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing"
        },
        "page_edited": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Edited"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLabel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoneyValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "CostLine",
      "type": "object"
    },
    "MoneyEstimate": {
      "additionalProperties": false,
      "description": "A money figure: an estimate rounded for display, or an exact value shown as it is.",
      "properties": {
        "exact": {
          "$ref": "#/$defs/MoneyValue"
        },
        "is_estimate": {
          "title": "Is Estimate",
          "type": "boolean"
        },
        "shown": {
          "$ref": "#/$defs/MoneyValue"
        }
      },
      "required": [
        "exact",
        "shown",
        "is_estimate"
      ],
      "title": "MoneyEstimate",
      "type": "object"
    },
    "MoneyValue": {
      "additionalProperties": false,
      "description": "An amount in integer minor units (pence, cents) and a currency code.",
      "properties": {
        "amount_minor": {
          "title": "Amount Minor",
          "type": "integer"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount_minor",
        "currency"
      ],
      "title": "MoneyValue",
      "type": "object"
    },
    "SourceLabel": {
      "additionalProperties": false,
      "description": "Where a value came from, and how fresh it is.",
      "properties": {
        "captured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At"
        },
        "data_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Date"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "status": {
          "enum": [
            "live",
            "cached",
            "fallback",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "source"
      ],
      "title": "SourceLabel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "activities": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostLine"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "budget": {
      "anyOf": [
        {
          "$ref": "#/$defs/MoneyValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "budget_gap": {
      "anyOf": [
        {
          "$ref": "#/$defs/MoneyEstimate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "budget_position": {
      "anyOf": [
        {
          "enum": [
            "under",
            "over",
            "on"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget Position"
    },
    "flights": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostLine"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "is_partial": {
      "default": true,
      "title": "Is Partial",
      "type": "boolean"
    },
    "kind": {
      "const": "cost_estimate",
      "title": "Kind",
      "type": "string"
    },
    "local_transport": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostLine"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "meals": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostLine"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "missing": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Missing"
    },
    "nights": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Nights"
    },
    "people": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "People"
    },
    "place": {
      "title": "Place",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceLabel"
      },
      "title": "Sources",
      "type": "array"
    },
    "state": {
      "enum": [
        "loading",
        "filled",
        "empty",
        "error",
        "not_known"
      ],
      "title": "State",
      "type": "string"
    },
    "stay": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostLine"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "total": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostLine"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "state",
    "sources",
    "kind",
    "place"
  ],
  "title": "CostEstimate",
  "type": "object"
}
