{
  "$defs": {
    "Conversion": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "$ref": "#/$defs/MoneyValue"
        },
        "converted": {
          "$ref": "#/$defs/MoneyValue"
        }
      },
      "required": [
        "amount",
        "converted"
      ],
      "title": "Conversion",
      "type": "object"
    },
    "MoneyValue": {
      "additionalProperties": false,
      "description": "An amount in integer minor units (pence, cents) and a currency code.",
      "properties": {
        "amount_minor": {
          "title": "Amount Minor",
          "type": "integer"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount_minor",
        "currency"
      ],
      "title": "MoneyValue",
      "type": "object"
    },
    "SourceLabel": {
      "additionalProperties": false,
      "description": "Where a value came from, and how fresh it is.",
      "properties": {
        "captured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At"
        },
        "data_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Date"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "status": {
          "enum": [
            "live",
            "cached",
            "fallback",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "source"
      ],
      "title": "SourceLabel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "conversion": {
      "anyOf": [
        {
          "$ref": "#/$defs/Conversion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "from_currency": {
      "default": "GBP",
      "pattern": "^[A-Z]{3}$",
      "title": "From Currency",
      "type": "string"
    },
    "kind": {
      "const": "money",
      "title": "Kind",
      "type": "string"
    },
    "missing": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Missing"
    },
    "rate": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rate"
    },
    "rate_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rate Date"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceLabel"
      },
      "title": "Sources",
      "type": "array"
    },
    "state": {
      "enum": [
        "loading",
        "filled",
        "empty",
        "error",
        "not_known"
      ],
      "title": "State",
      "type": "string"
    },
    "to_currency": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "To Currency"
    }
  },
  "required": [
    "state",
    "sources",
    "kind"
  ],
  "title": "Money",
  "type": "object"
}
