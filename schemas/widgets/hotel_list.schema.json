{
  "$defs": {
    "Hotel": {
      "additionalProperties": false,
      "properties": {
        "area": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Area"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "stars": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stars"
        },
        "website": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Website"
        }
      },
      "required": [
        "name"
      ],
      "title": "Hotel",
      "type": "object"
    },
    "SourceLabel": {
      "additionalProperties": false,
      "description": "Where a value came from, and how fresh it is.",
      "properties": {
        "captured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At"
        },
        "data_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Date"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "status": {
          "enum": [
            "live",
            "cached",
            "fallback",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "source"
      ],
      "title": "SourceLabel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chosen_hotel": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chosen Hotel"
    },
    "hotels": {
      "items": {
        "$ref": "#/$defs/Hotel"
      },
      "title": "Hotels",
      "type": "array"
    },
    "kind": {
      "const": "hotel_list",
      "title": "Kind",
      "type": "string"
    },
    "missing": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Missing"
    },
    "place": {
      "title": "Place",
      "type": "string"
    },
    "selection": {
      "default": "undecided",
      "enum": [
        "undecided",
        "chosen",
        "skipped",
        "changed"
      ],
      "title": "Selection",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceLabel"
      },
      "title": "Sources",
      "type": "array"
    },
    "state": {
      "enum": [
        "loading",
        "filled",
        "empty",
        "error",
        "not_known"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "state",
    "sources",
    "kind",
    "place"
  ],
  "title": "HotelList",
  "type": "object"
}
